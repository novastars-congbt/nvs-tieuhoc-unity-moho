      m_Calls: []
  m_text: "<b>I. M\u1EE5c ti\xEAu</b>\r\n- H\u1ECDc sinh \u0111\u01B0\u1EE3c t\xECm
    hi\u1EC3u v\u1EC1 c\xE1c \u0111\u1ECBa danh in tr\xEAn ti\u1EC1n Vi\u1EC7t Nam
    v\xE0 luy\u1EC7n t\u1EADp t\xEDnh ti\u1EC1n nhanh, s\u1EED d\u1EE5ng ti\u1EC1n
    c\xF3 m\u1EC7nh gi\xE1 ph\xF9 h\u1EE3p khi thanh to\xE1\n\r\n<b>II. Chu\u1EA9n
    b\u1ECB tr\u01B0\u1EDBc bu\u1ED5i h\u1ECDc</b>\r\n- Gi\xE1o vi\xEAn: Ph\u1EA7n
    m\u1EC1m K\u0129 n\u0103ng s\u1ED1ng Novastars\r\n- H\u1ECDc sinh: H\u1ED9p b\xFAt
    c\xE1 nh\xE2n, gi\u1EA5y vi\u1EBFt, b\xFA"
