  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>I. M\u1EE5c ti\xEAu</b>\r\n1. H\u1ECDc sinh hi\u1EC3u vi khu\u1EA9n,
    vi r\xFAt c\xF3 \u1EDF kh\u1EAFp m\u1ECDi n\u01A1i v\xE0 c\xF3 th\u1EC3 g\xE2y
    b\u1EC7nh\r.\n2. H\u1ECDc sinh bi\u1EBFt c\xE1ch ph\xF2ng b\u1EC7nh do vi khu\u1EA9n,
    vi r\xFAt\r.\n3. H\u1ECDc sinh nh\u1EADn di\u1EC7n h\xE0nh vi c\xF3 nguy c\u01A1
    v\xE0 c\xE1c h\xE0nh vi \u0111\xFAng \u0111\u1EC3 b\u1EA3o v\u1EC7 s\u1EE9c kh\u1ECFe.\n\r\n<b>II.
    Chu\u1EA9n b\u1ECB tr\u01B0\u1EDBc bu\u1ED5i h\u1ECDc</b>\r\n- Gi\xE1o vi\xEAn:
    Ph\u1EA7n m\u1EC1m K\u0129 n\u0103ng s\u1ED1ng Novastars\r\n- H\u1ECDc sinh:
    Gi\u1EA5y, b\xFAt"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 718b7eacc6e74ec4e95a0c84e0fdb45c, type: 2}
