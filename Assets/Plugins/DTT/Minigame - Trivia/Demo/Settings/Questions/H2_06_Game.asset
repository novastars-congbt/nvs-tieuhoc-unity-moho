  m_Script: {fileID: 11500000, guid: d2b82101436f30f4bb30ac6916e43f80, type: 3}
  m_Name: H2_06_Game
  m_EditorClassIdentifier: 
  _randomizeQuestions: 0
  _isNotNumbered: 0
  _timePerQuestion: 10
  _allQuestions:
  - _title: "Khi \u0111i ch\u01A1i \u1EDF n\u01A1i c\xF3 nhi\u1EC1u c\xE2y c\u1ED1i,
      b\u1EA1n n\xEAn l\xE0m g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: 342470c72c8798b49b4a1cb963a1304e, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 13cf540b7bff3a24e8da529ab49e709b, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "M\u1EB7c \xE1o ng\u1EAFn tay cho m\xE1t."
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "M\u1EB7c \xE1o d\xE0i tay \u0111\u1EC3 tr\xE1nh c\xF4n tr\xF9ng \u0111\u1ED1t."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "Khi \u0111i ng\u1EE7, \u0111\u1EC3 tr\xE1nh mu\u1ED7i \u0111\u1ED1t,
      b\u1EA1n n\xEAn l\xE0m g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: caeafd1df7430404e9195ca258288b57, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 133e7789593755c44892d586a1ca3d6d, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "Ng\u1EE7 trong m\xE0n."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "Ng\u1EE7 ngo\xE0i s\xE2n cho m\xE1t."
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "Khi b\u1ECB c\xF4n tr\xF9ng \u0111\u1ED1t, vi\u1EC7c \u0111\u1EA7u ti\xEAn
      b\u1EA1n c\u1EA7n l\xE0m l\xE0 g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: ce152b8a48069ee48a280fb8f2515500, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 36152d202913ccd45bc10cc31185e0b1, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "G\xE3i th\u1EADt m\u1EA1nh cho \u0111\u1EE1 ng\u1EE9a"
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "B\xE1o cho ng\u01B0\u1EDDi l\u1EDBn bi\u1EBFt."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "Khi b\u1ECB c\xF4n tr\xF9ng c\u1EAFn, n\u1EBFu b\u1ECB \u0111au v\xE0
      s\u01B0ng \u0111\u1ECF, vi\u1EC7c b\u1EA1n c\u1EA7n l\xE0m l\xE0 g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: 7294d4c699776e147a379a0cda518ab8, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 963a06e2dc9f7d340ae8e330d7fe637f, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "R\u1EEDa v\u1EBFt \u0111\u1ED1t b\u1EB1ng n\u01B0\u1EDBc s\u1EA1ch
        ho\u1EB7c n\u01B0\u1EDBc mu\u1ED1i sinh l\xFD."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "D\xF9ng d\u1EA7u n\xF3ng b\xF4i l\xEAn v\u1EBFt c\xF4n tr\xF9ng \u0111\u1ED1t."
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "\u0110\xE2u l\xE0 c\xE1ch v\u1EC7 sinh tai an to\xE0n?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: c6fcab367d52e044292ba699e3f451a2, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 869a3e41bc0898047a41e5ce73d95e3a, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "D\xF9ng kh\u0103n s\u1EA1ch lau tai (l\u1ED7 tai, v\xE0nh tai v\xE0
        ph\xEDa sau tai)"
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "D\xF9ng b\xFAt \u0111\u1EC3 ngo\xE1y tai"
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "Khi b\u1ECB n\u01B0\u1EDBc v\xE0o tai, b\u1EA1n n\xEAn l\xE0m g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: 44c4eb6988256694cb174bcebd5cacb8, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: f9d75da85e1895b47a5d9abbab27440f, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "Nghi\xEAng \u0111\u1EA7u v\xE0 nh\u1EA3y nh\u1EB9, lau b\u1EB1ng kh\u0103n."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "D\xF9ng b\xF4ng ngo\xE1y s\xE2u v\xE0o b\xEAn trong tai."
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
  - _title: "Khi b\u1ECB \u0111au tai ho\u1EB7c \xF9 tai, b\u1EA1n n\xEAn l\xE0m
      g\xEC?"
    _questionSpr: {fileID: 0}
    _questionAudio: {fileID: 8300000, guid: 2aaa3ba3ad144b54a99a81e239ba5363, type: 3}
    _audioClipFinish: {fileID: 8300000, guid: 005c58f77e41f844381ef2cf29b06a60, type: 3}
    _matchCorrectAnswers: 0
    _useTitle: 1
    _answers:
    - _body: "Im l\u1EB7ng v\xE0 ch\u1EDD cho h\u1EBFt \u0111au."
      _isCorrect: 0
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
    - _body: "B\xE1o cho ng\u01B0\u1EDDi l\u1EDBn bi\u1EBFt."
      _isCorrect: 1
      _spr: {fileID: 0}
      _audio: {fileID: 0}
      _audioWrong: {fileID: 0}
